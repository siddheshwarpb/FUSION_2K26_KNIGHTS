# Qualys Platform Integration — PatchOrder
# Copy this file to .env and fill in your credentials
# Never commit the .env file with real values

# Qualys Gateway Platform (e.g. gateway.qg1.apps.qualys.com)
QUALYS_PLATFORM=gateway.qg1.apps.qualys.com

# Qualys OAuth2 Client Credentials (from Qualys Admin > API Keys)
QUALYS_CLIENT_ID=your-client-id-here
QUALYS_CLIENT_SECRET=your-client-secret-here

# Optional: path to QScanner binary (defaults to searching PATH)
QUALYS_QSCANNER_PATH=./qscanner

# Timeout in seconds for QScanner subprocess (default 300)
QUALYS_SCAN_TIMEOUT=300
